{
  "name": "build-your-own-radar",
  "version": "1.1.4",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:dev": "webpack --mode development --config webpack.dev.js",
    "build:prod": "webpack --mode production --config webpack.prod.js",
    "dev": "webpack-dev-server --mode development --config webpack.dev.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress open --env host=$TEST_URL",
    "test:e2e-headless": "cypress run --browser chrome --record false --env host=$TEST_URL",
    "lint-prettier:check": "eslint . && prettier --check .",
    "lint-prettier:fix": "eslint . --fix && prettier --write .",
    "quality": "npm run lint-prettier:check && npm run test:coverage"
  },
  "author": "Thoughtworks",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoughtworks/build-your-own-radar"
  },
  "keywords": [
    "tech-radar"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "cssnano": "^7.1.5",
    "cypress": "^15.13.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.3.1",
    "eslint-plugin-jest": "^29.15.2",
    "expose-loader": "^5.0.1",
    "html-webpack-plugin": "^5.6.6",
    "jest": "^30.3.0",
    "jest-css-modules-transform": "^4.4.2",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.2",
    "mini-css-extract-plugin": "^2.10.2",
    "mochawesome": "^7.1.4",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.2.1",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "chance": "^1.1.13",
    "d3": "^7.9.0",
    "d3-tip": "^0.9.1",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "lodash": "^4.18.1",
    "sanitize-html": "^2.17.2"
  },
  "standard": {
    "globals": [
      "Cypress",
      "cy",
      "XMLHttpRequest"
    ],
    "env": [
